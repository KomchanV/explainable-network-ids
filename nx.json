{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "release/0.1-alpha",
  "workspaceLayout": { "appsDir": "apps", "libsDir": "packages" },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": ["{workspaceRoot}/pnpm-lock.yaml", "{workspaceRoot}/package.json", "{workspaceRoot}/nx.json", { "runtime": "node --version" }, { "runtime": "pnpm --version" }],
    "pythonCore": ["{workspaceRoot}/src/**/*.py", "{workspaceRoot}/tests/**/*.py", "{workspaceRoot}/scripts/**/*.py", "{workspaceRoot}/app.py", "{workspaceRoot}/requirements.txt"]
  },
  "targetDefaults": {
    "serve": { "cache": false, "continuous": true },
    "train": { "cache": false }
  },
  "analytics": false
}
