  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Workspace action with native disabled and keyboard states.",
      "html": "<button class=\"ds-button-primary\">Apply filters</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:2.75rem;padding:.5rem 1rem;border:1px solid var(--border);border-radius:.5rem;font-size:.875rem;font-weight:500;cursor:pointer;background:var(--primary);color:var(--primary-foreground);border-color:var(--primary);} .ds-button-primary:hover{background:color-mix(in oklab,var(--primary) 90%,transparent);} .ds-button-primary:focus-visible{outline:2px solid var(--ring);outline-offset:2px} .ds-button-primary:active:not(:disabled){transform:translateY(1px)} .ds-button-primary:disabled{cursor:not-allowed;opacity:.5}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Workspace action with native disabled and keyboard states.",
      "html": "<button class=\"ds-button-secondary\">Apply filters</button>",
      "css": ".ds-button-secondary{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:2.75rem;padding:.5rem 1rem;border:1px solid var(--border);border-radius:.5rem;font-size:.875rem;font-weight:500;cursor:pointer;background:var(--card);color:var(--foreground);border-color:var(--border);} .ds-button-secondary:hover{background:var(--accent);} .ds-button-secondary:focus-visible{outline:2px solid var(--ring);outline-offset:2px} .ds-button-secondary:active:not(:disabled){transform:translateY(1px)} .ds-button-secondary:disabled{cursor:not-allowed;opacity:.5}"
    },
    {
      "name": "Destructive button",
      "kind": "button",
      "refersTo": "button-destructive",
      "description": "Workspace action with native disabled and keyboard states.",
      "html": "<button class=\"ds-button-destructive\">Apply filters</button>",
      "css": ".ds-button-destructive{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:2.75rem;padding:.5rem 1rem;border:1px solid var(--border);border-radius:.5rem;font-size:.875rem;font-weight:500;cursor:pointer;background:var(--card);color:var(--danger);border-color:var(--danger);} .ds-button-destructive:hover{background:var(--danger-surface);} .ds-button-destructive:focus-visible{outline:2px solid var(--ring);outline-offset:2px} .ds-button-destructive:active:not(:disabled){transform:translateY(1px)} .ds-button-destructive:disabled{cursor:not-allowed;opacity:.5}"
    },
    {
      "name": "Labeled input",
      "kind": "input",
      "refersTo": "input",
      "description": "Native probability input with explicit label.",
      "html": "<label class=\"ds-field\">Min P(DDoS)<input type=\"number\" min=\"0\" max=\"1\" step=\".01\" value=\"0\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:.5rem;font-size:.75rem;font-weight:500;color:var(--muted-foreground)}.ds-field input{min-height:2.75rem;padding:.5rem .75rem;border:1px solid var(--input);border-radius:.5rem;background:var(--background);color:var(--foreground);font:inherit;font-size:.875rem}.ds-field input:focus-visible{outline:2px solid var(--ring);outline-offset:3px}"
    },
    {
      "name": "Prediction badge",
      "kind": "chip",
      "refersTo": "badge-benign",
      "description": "Noninteractive predicted class label.",
      "html": "<span class=\"ds-badge\">BENIGN</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;gap:.375rem;border-radius:.375rem;padding:.25rem .5rem;font-size:.75rem;font-weight:600;color:var(--benign);background:var(--benign-surface)}"
    },
    {
      "name": "Workspace panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Flat bordered reading surface.",
      "html": "<section class=\"ds-panel\"><h2>Prediction distribution</h2><p>Predictions are not verified ground truth.</p></section>",
      "css": ".ds-panel{border:1px solid var(--border);border-radius:1rem;background:var(--card);color:var(--foreground);padding:1.25rem}.ds-panel h2{font-size:1rem;font-weight:600}.ds-panel p{font-size:.875rem;color:var(--muted-foreground)}@media(min-width:640px){.ds-panel{padding:1.5rem}}"
    },
    {
      "name": "Rail navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Graphite wayfinding with an explicit current page.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace\"><a href=\"#overview\" aria-current=\"page\">Overview</a><a href=\"#explorer\">Traffic Explorer</a></nav>",
      "css": ".ds-nav{display:grid;gap:.5rem;background:var(--rail);padding:1rem}.ds-nav a{display:flex;align-items:center;gap:.75rem;padding:.8rem .9rem;border-radius:.5rem;font-size:.875rem;color:var(--rail-muted);text-decoration:none}.ds-nav a:hover,.ds-nav a[aria-current=\"page\"]{color:var(--rail-text);background:var(--rail-active)}.ds-nav a[aria-current=\"page\"]{font-weight:600}.ds-nav a:focus-visible{outline:2px solid var(--ring);outline-offset:3px}"
    }
  ],
  "narrative": {
    "northStar": "Technical field guide",
    "overview": "A restrained technical field guide for investigating saved network flows. Graphite navigation, mineral teal actions and cool neutral work surfaces keep predictions, measurements and explanations legible. This is an operational interface: system sans supports reading and wayfinding; monospace supports measurements and identifiers.\n\nThe workspace presents model output with nearby scientific context. Uploaded prediction distribution, local class-1 SHAP and saved held-out evaluation remain visibly distinct.",
    "keyCharacteristics": [
      "Graphite navigation and mineral teal actions",
      "Compact headings, readable controls and aligned measurements",
      "Border-defined surfaces with semantic scientific color",
      "Responsive investigation drawer and explicit data caveats"
    ],
    "rules": [
      {
        "name": "Semantic Direction",
        "body": "Red marks predicted DDoS or increasing P(DDoS); teal marks predicted BENIGN or decreasing P(DDoS). Pair color with readable class names or signed direction. Neither color establishes a verified incident.",
        "section": "colors"
      },
      {
        "name": "Operational Type",
        "body": "Use sans for headings, labels and explanatory prose; reserve monospace for numeric output and technical identifiers.",
        "section": "typography"
      },
      {
        "name": "Flat Workspace",
        "body": "Separate ordinary surfaces with tone and borders. The investigation drawer carries the structural shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep probability and SHAP caveats beside their output.",
      "Do preserve labels, visible focus, textual status and keyboard-accessible horizontal scrolling.",
      "Do use the semantic light/dark variables rather than hard-coded light surfaces.",
      "Do preserve native drawer modes and return focus to the originating record."
    ],
    "donts": [
      "Don't describe uncalibrated P(DDoS) as confidence, severity or verified ground truth.",
      "Don't equate uploaded predicted DDoS share with held-out evaluation accuracy.",
      "Don't introduce cyberpunk effects or fabricated live monitoring claims."
    ]
  }
}
