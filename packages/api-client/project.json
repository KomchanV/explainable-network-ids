{
  "name": "api-client",
  "projectType": "library",
  "tags": ["type:contract", "lang:typescript"],
  "implicitDependencies": ["api"],
  "targets": {
    "generate": {
      "dependsOn": ["api:openapi"],
      "command": "pnpm --filter @ids/api-client exec openapi-typescript openapi.json -o src/schema.d.ts",
      "cache": false
    },
    "check": {
      "dependsOn": ["api:openapi-check"],
      "command": "pnpm --filter @ids/api-client exec openapi-typescript openapi.json -o src/schema.d.ts --check",
      "cache": false
    }
  }
}
