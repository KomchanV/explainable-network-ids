{
  "components": {
    "schemas": {
      "ErrorDetail": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "model_available": {
            "title": "Model Available",
            "type": "boolean"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version",
          "model_available"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ModelResponse": {
        "properties": {
          "classifier": {
            "const": "RandomForestClassifier",
            "title": "Classifier",
            "type": "string"
          },
          "dataset_filename": {
            "title": "Dataset Filename",
            "type": "string"
          },
          "dataset_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dataset Sha256"
          },
          "feature_schema": {
            "items": {
              "type": "string"
            },
            "title": "Feature Schema",
            "type": "array"
          },
          "format_version": {
            "title": "Format Version",
            "type": "integer"
          },
          "label_mapping": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Label Mapping",
            "type": "object"
          },
          "provenance": {
            "enum": [
              "synthetic",
              "cic-ids2017",
              "unspecified"
            ],
            "title": "Provenance",
            "type": "string"
          },
          "random_state": {
            "title": "Random State",
            "type": "integer"
          },
          "test_rows": {
            "title": "Test Rows",
            "type": "integer"
          },
          "train_rows": {
            "title": "Train Rows",
            "type": "integer"
          }
        },
        "required": [
          "format_version",
          "classifier",
          "feature_schema",
          "label_mapping",
          "provenance",
          "dataset_filename",
          "dataset_sha256",
          "train_rows",
          "test_rows",
          "random_state"
        ],
        "title": "ModelResponse",
        "type": "object"
      },
      "PredictRequest": {
        "additionalProperties": false,
        "properties": {
          "rows": {
            "items": {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "object"
            },
            "maxItems": 1000,
            "minItems": 1,
            "title": "Rows",
            "type": "array"
          }
        },
        "required": [
          "rows"
        ],
        "title": "PredictRequest",
        "type": "object"
      },
      "PredictResponse": {
        "properties": {
          "ignored_columns": {
            "items": {
              "type": "string"
            },
            "title": "Ignored Columns",
            "type": "array"
          },
          "imputed_cells": {
            "title": "Imputed Cells",
            "type": "integer"
          },
          "predictions": {
            "items": {
              "$ref": "#/components/schemas/Prediction"
            },
            "title": "Predictions",
            "type": "array"
          }
        },
        "required": [
          "predictions",
          "ignored_columns",
          "imputed_cells"
        ],
        "title": "PredictResponse",
        "type": "object"
      },
      "Prediction": {
        "properties": {
          "ddos_probability": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Ddos Probability",
            "type": "number"
          },
          "prediction": {
            "enum": [
              "BENIGN",
              "DDoS"
            ],
            "title": "Prediction",
            "type": "string"
          },
          "row_number": {
            "title": "Row Number",
            "type": "integer"
          }
        },
        "required": [
          "row_number",
          "prediction",
          "ddos_probability"
        ],
        "title": "Prediction",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Offline academic BENIGN/DDoS classifier. No live traffic monitoring.",
    "title": "Explainable Network IDS API",
    "version": "0.2.0-alpha.1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Health"
      }
    },
    "/model": {
      "get": {
        "operationId": "getModel",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Model"
      }
    },
    "/predict": {
      "post": {
        "operationId": "predictFlows",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PredictRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Predict"
      }
    }
  }
}
