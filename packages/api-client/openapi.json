    "/api/v1/analyses/{id}/explanations/global": {
      "get": {
        "operationId": "explainAnalysisSample",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "title": "Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "sample_size",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Sample Size",
              "type": "integer"
            }
          },
          {
            "description": "Defaults to min(15, model feature count).",
            "in": "query",
            "name": "top_n",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Defaults to min(15, model feature count).",
              "title": "Top N"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GlobalExplanation"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
