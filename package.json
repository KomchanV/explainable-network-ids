{
  "name": "explainable-network-ids",
  "version": "0.2.0-alpha.1",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.17.0",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "nx run-many -t serve -p api,web --parallel=2",
    "dev:web": "nx serve web",
    "dev:api": "nx serve api",
