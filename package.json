    "check": "nx run-many -t check",
    "build": "nx build web",
    "graph": "nx graph",
    "contract:generate": "nx run api-client:generate",
    "contract:check": "nx run api-client:check"
  },
  "devDependencies": {
    "nx": "24.0.2"
  },
  "nx": {
    "includedScripts": []
  }
}
